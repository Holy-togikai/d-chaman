[{"id":"mestin-takikomi","name":"さばと生姜の炊き込みごはん","summary":"さば缶の汁ごと米に入れて炊く。山頂で炊きたてが食べられる、手間の割に贅沢な一品。","gear":["バーナー","メスティン"],"cookingMinutes":30,"effort":3,"needsCooler":false,"servings":2,"ingredients":[{"id":"kome","name":"無洗米","aisle":"乾物・保存食","quantity":1,"unit":"合"},{"id":"saba_kan","name":"さば水煮缶","aisle":"乾物・保存食","quantity":1,"unit":"缶"},{"id":"shouga","name":"しょうが","aisle":"野菜・果物","quantity":1,"unit":"片"},{"id":"shouyu","name":"しょうゆ","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"sake","name":"料理酒","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"kona_dashi","name":"和風だしの素","aisle":"乾物・保存食","quantity":1,"unit":"小さじ"},{"id":"naganegi","name":"長ねぎ","aisle":"野菜・果物","quantity":0.5,"unit":"本"}],"steps":["米1合をメスティンに入れ、水200mlを加えて30分ほど吸水させる（歩きながらで良い）。","しょうがを千切り、長ねぎを小口切りにする。家で切って持参しても良い。","さば缶を汁ごと加え、しょうゆ・酒・だしの素・しょうがを入れて軽く混ぜる。","ふたをして中火。沸騰したら弱火で12分、火を止めて10分蒸らす。","長ねぎを散らし、さばを軽くほぐして混ぜる。"],"tips":"吸水をさぼると芯が残る。登山口で水を入れて歩き出すと、山頂で丁度良い。"},{"id":"skillet-ajillo","name":"えびときのこのアヒージョ","summary":"オイルで煮るだけ。残ったオイルにバゲットを浸すところまでが本番。","gear":["バーナー","フライパン"],"cookingMinutes":15,"effort":2,"needsCooler":true,"servings":2,"ingredients":[{"id":"ebi","name":"むきえび","aisle":"肉・魚","quantity":120,"unit":"g"},{"id":"kinoko","name":"しめじ","aisle":"野菜・果物","quantity":1,"unit":"パック"},{"id":"ninniku","name":"にんにく","aisle":"野菜・果物","quantity":2,"unit":"片"},{"id":"orribu_oil","name":"オリーブオイル","aisle":"調味料","quantity":6,"unit":"大さじ"},{"id":"shio","name":"塩","aisle":"調味料","quantity":null,"unit":null},{"id":"kurokoshou","name":"粗挽き黒こしょう","aisle":"調味料","quantity":null,"unit":null},{"id":"baguette","name":"バゲット","aisle":"パン・主食","quantity":20,"unit":"cm"}],"steps":["にんにくを薄切り、しめじをほぐす。えびは水気を切っておく。","フライパンにオリーブオイルとにんにくを入れ、弱火でじっくり香りを出す。","きのことえびを加え、塩をふって弱火のまま5分ほど煮る。","黒こしょうを挽き、バゲットを添える。"],"tips":"えびは保冷が要る。凍らせて持つと保冷剤を兼ねられる。"},{"id":"pot-tomato-stew","name":"ベーコンと豆のトマト煮込み","summary":"缶詰中心で保冷が要らない。冷えた体に一番効く。","gear":["バーナー","クッカー"],"cookingMinutes":20,"effort":2,"needsCooler":false,"servings":2,"ingredients":[{"id":"kanzume_tomato","name":"カットトマト缶","aisle":"乾物・保存食","quantity":1,"unit":"缶"},{"id":"beikon","name":"ベーコン","aisle":"肉・魚","quantity":60,"unit":"g"},{"id":"tamanegi","name":"玉ねぎ","aisle":"野菜・果物","quantity":0.5,"unit":"個"},{"id":"ninniku","name":"にんにく","aisle":"野菜・果物","quantity":1,"unit":"片"},{"id":"torinikuno_dashi","name":"固形コンソメ","aisle":"乾物・保存食","quantity":1,"unit":"個"},{"id":"orribu_oil","name":"オリーブオイル","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"shio","name":"塩","aisle":"調味料","quantity":null,"unit":null},{"id":"kurokoshou","name":"粗挽き黒こしょう","aisle":"調味料","quantity":null,"unit":null},{"id":"funmatsu_chiizu","name":"粉チーズ","aisle":"乳製品・卵","quantity":10,"unit":"g"}],"steps":["玉ねぎとにんにくをみじん切り、ベーコンを 短冊に切る。","オリーブオイルで玉ねぎ・にんにく・ベーコンを炒める。","トマト缶とコンソメを入れ、10分ほど煮詰める。","塩こしょうで整え、粉チーズをかける。"],"tips":"煮詰めるほど旨い。水を足さず、トマト缶の水分だけで煮る。"},{"id":"mestin-pasta-carbonara","name":"メスティンのカルボナーラ","summary":"茹で汁を捨てない作り方。水の持ち上げを減らしつつ、濃厚に仕上がる。","gear":["バーナー","メスティン"],"cookingMinutes":20,"effort":4,"needsCooler":true,"servings":1,"ingredients":[{"id":"pasta","name":"スパゲッティ","aisle":"乾物・保存食","quantity":100,"unit":"g"},{"id":"beikon","name":"ベーコン","aisle":"肉・魚","quantity":40,"unit":"g"},{"id":"tamago","name":"卵","aisle":"乳製品・卵","quantity":1,"unit":"個"},{"id":"funmatsu_chiizu","name":"粉チーズ","aisle":"乳製品・卵","quantity":20,"unit":"g"},{"id":"nama_kuriimu","name":"生クリーム","aisle":"乳製品・卵","quantity":50,"unit":"ml"},{"id":"ninniku","name":"にんにく","aisle":"野菜・果物","quantity":1,"unit":"片"},{"id":"orribu_oil","name":"オリーブオイル","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"kurokoshou","name":"粗挽き黒こしょう","aisle":"調味料","quantity":null,"unit":null},{"id":"shio","name":"塩","aisle":"調味料","quantity":null,"unit":null}],"steps":["卵・粉チーズ・生クリームを先に混ぜ、ソースを作っておく。","メスティンに水300mlと塩を入れ、半分に折ったパスタを茹でる（表示時間＋1分）。","水分がほぼ無くなったら、ベーコンとにんにくを加えて軽く炒める。","**火から下ろしてから**ソースを加え、余熱で混ぜる。","黒こしょうを多めに挽く。"],"tips":"火にかけたままソースを入れると卵が固まる。必ず下ろしてから。"},{"id":"pot-thai-curry","name":"ココナッツとえびのグリーンカレー風","summary":"ココナッツミルクとナンプラーで、山の上とは思えない香りになる。","gear":["バーナー","クッカー"],"cookingMinutes":20,"effort":3,"needsCooler":true,"servings":2,"ingredients":[{"id":"kokonattsu","name":"ココナッツミルク","aisle":"乾物・保存食","quantity":200,"unit":"ml"},{"id":"ebi","name":"むきえび","aisle":"肉・魚","quantity":100,"unit":"g"},{"id":"kinoko","name":"しめじ","aisle":"野菜・果物","quantity":1,"unit":"パック"},{"id":"kare_ko","name":"カレー粉","aisle":"調味料","quantity":2,"unit":"小さじ"},{"id":"nanmi","name":"ナンプラー","aisle":"調味料","quantity":2,"unit":"小さじ"},{"id":"satou","name":"砂糖","aisle":"調味料","quantity":1,"unit":"小さじ"},{"id":"ninniku","name":"にんにく","aisle":"野菜・果物","quantity":1,"unit":"片"},{"id":"goma_abura","name":"ごま油","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"kome","name":"無洗米","aisle":"乾物・保存食","quantity":1,"unit":"合"}],"steps":["別鍋かメスティンで米を炊いておく（無洗米1合・水200ml・弱火12分・蒸らし10分）。","ごま油でにんにくときのこを炒める。","カレー粉を加えて油となじませ、香りを立てる。","ココナッツミルクとえびを入れ、5分煮る。","ナンプラーと砂糖で味を決める。"],"tips":"カレー粉を油で炒めるひと手間で、香りがまるで変わる。"},{"id":"skillet-ahijo-chicken","name":"鶏もも肉のレモンバター焼き","summary":"焼くだけだが、レモンとバターで一気に料理らしくなる。","gear":["バーナー","フライパン"],"cookingMinutes":20,"effort":2,"needsCooler":true,"servings":2,"ingredients":[{"id":"tori_momo","name":"鶏もも肉","aisle":"肉・魚","quantity":250,"unit":"g"},{"id":"bataa","name":"バター","aisle":"乳製品・卵","quantity":15,"unit":"g"},{"id":"lemon","name":"レモン","aisle":"野菜・果物","quantity":0.5,"unit":"個"},{"id":"ninniku","name":"にんにく","aisle":"野菜・果物","quantity":1,"unit":"片"},{"id":"shio","name":"塩","aisle":"調味料","quantity":null,"unit":null},{"id":"kurokoshou","name":"粗挽き黒こしょう","aisle":"調味料","quantity":null,"unit":null},{"id":"paseri","name":"パセリ","aisle":"野菜・果物","quantity":1,"unit":"枝"}],"steps":["鶏ももは家で一口大に切り、塩こしょうをして持参する。","フライパンで皮目から焼き、焼き色が付いたら返す。","にんにくとバターを加え、溶けたバターを鶏にかけながら焼く。","レモンを搾り、パセリを散らす。"],"tips":"家で下味を付けておくと、山での手順が3つに減る。"},{"id":"pot-kouya-nimono","name":"高野豆腐ときのこの含め煮","summary":"乾物中心で荷が軽い。汁まで飲める、体が温まる一品。","gear":["バーナー","クッカー"],"cookingMinutes":20,"effort":2,"needsCooler":false,"servings":2,"ingredients":[{"id":"kouya_doufu","name":"高野豆腐","aisle":"乾物・保存食","quantity":2,"unit":"枚"},{"id":"kinoko","name":"しめじ","aisle":"野菜・果物","quantity":1,"unit":"パック"},{"id":"ninjin","name":"にんじん","aisle":"野菜・果物","quantity":0.5,"unit":"本"},{"id":"kona_dashi","name":"和風だしの素","aisle":"乾物・保存食","quantity":1,"unit":"小さじ"},{"id":"shouyu","name":"しょうゆ","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"mirin","name":"みりん","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"satou","name":"砂糖","aisle":"調味料","quantity":1,"unit":"小さじ"}],"steps":["水400mlにだしの素を溶かし、火にかける。","高野豆腐を割り入れ、にんじんときのこを加える。","しょうゆ・みりん・砂糖を入れ、10分ほど煮る。","高野豆腐が汁を吸って膨らんだら出来上がり。"],"tips":"高野豆腐は割って入れると早く戻る。汁を多めにして残りを翌朝の雑炊にしても良い。"},{"id":"mestin-mushi-pork","name":"豚バラとキャベツの重ね蒸し","summary":"重ねて蒸すだけ。水をほとんど使わず、野菜の水分で火を通す。","gear":["バーナー","メスティン"],"cookingMinutes":20,"effort":2,"needsCooler":true,"servings":2,"ingredients":[{"id":"buta_bara","name":"豚バラ肉","aisle":"肉・魚","quantity":200,"unit":"g"},{"id":"kyabetsu","name":"キャベツ","aisle":"野菜・果物","quantity":4,"unit":"枚"},{"id":"shouga","name":"しょうが","aisle":"野菜・果物","quantity":1,"unit":"片"},{"id":"sake","name":"料理酒","aisle":"調味料","quantity":2,"unit":"大さじ"},{"id":"shouyu","name":"しょうゆ","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"goma_abura","name":"ごま油","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"shio","name":"塩","aisle":"調味料","quantity":null,"unit":null}],"steps":["キャベツをちぎり、メスティンに敷く。","豚バラとしょうがの千切りを重ね、塩をふる。これを2段くり返す。","酒を回しかけ、ふたをして弱火で12分蒸す。","しょうゆとごま油をかける。"],"tips":"焦げそうなら水を大さじ2足す。キャベツを下に敷くのが焦げ防止になる。"},{"id":"pot-ajillo-asari","name":"あさりと白いんげんのスープ","summary":"缶詰だけで作れるのに出汁が出る。パンを浸して食べたい。","gear":["バーナー","クッカー"],"cookingMinutes":15,"effort":1,"needsCooler":false,"servings":2,"ingredients":[{"id":"asari","name":"あさり水煮缶","aisle":"乾物・保存食","quantity":1,"unit":"缶"},{"id":"beikon","name":"ベーコン","aisle":"肉・魚","quantity":40,"unit":"g"},{"id":"tamanegi","name":"玉ねぎ","aisle":"野菜・果物","quantity":0.5,"unit":"個"},{"id":"ninniku","name":"にんにく","aisle":"野菜・果物","quantity":1,"unit":"片"},{"id":"orribu_oil","name":"オリーブオイル","aisle":"調味料","quantity":1,"unit":"大さじ"},{"id":"torinikuno_dashi","name":"固形コンソメ","aisle":"乾物・保存食","quantity":1,"unit":"個"},{"id":"kurokoshou","name":"粗挽き黒こしょう","aisle":"調味料","quantity":null,"unit":null},{"id":"baguette","name":"バゲット","aisle":"パン・主食","quantity":20,"unit":"cm"}],"steps":["玉ねぎとにんにくをみじん切りにし、オリーブオイルで炒める。","ベーコンを加えて炒め、水300mlとコンソメを入れる。","あさりを汁ごと加え、5分煮る。","黒こしょうを挽き、バゲットを添える。"],"tips":"あさりの汁に塩気があるので、味見してから塩を足す。"},{"id":"skillet-tortilla","name":"ソーセージとチーズのケサディーヤ","summary":"挟んで焼くだけ。手が汚れず、歩きながらでも食べられる。","gear":["バーナー","フライパン"],"cookingMinutes":10,"effort":1,"needsCooler":true,"servings":2,"ingredients":[{"id":"tortilla","name":"トルティーヤ","aisle":"パン・主食","quantity":2,"unit":"枚"},{"id":"souseiji","name":"ソーセージ","aisle":"肉・魚","quantity":3,"unit":"本"},{"id":"chiizu","name":"とろけるチーズ","aisle":"乳製品・卵","quantity":60,"unit":"g"},{"id":"tamanegi","name":"玉ねぎ","aisle":"野菜・果物","quantity":0.25,"unit":"個"},{"id":"kare_ko","name":"カレー粉","aisle":"調味料","quantity":1,"unit":"小さじ"},{"id":"orribu_oil","name":"オリーブオイル","aisle":"調味料","quantity":1,"unit":"大さじ"}],"steps":["ソーセージを輪切り、玉ねぎを薄切りにする。","フライパンで具を炒め、カレー粉をふる。","トルティーヤにチーズと具をのせ、半分に折る。","両面を焼き、チーズが溶けたら切り分ける。"],"tips":"カレー粉はひとふりで味が締まる。入れすぎない。"},{"id":"pot-zousui","name":"きのこと卵の雑炊","summary":"前夜の残りや朝に。短時間で作れて、胃にやさしい。","gear":["バーナー","クッカー"],"cookingMinutes":15,"effort":1,"needsCooler":true,"servings":1,"ingredients":[{"id":"kome","name":"無洗米","aisle":"乾物・保存食","quantity":0.5,"unit":"合"},{"id":"tamago","name":"卵","aisle":"乳製品・卵","quantity":1,"unit":"個"},{"id":"kinoko","name":"しめじ","aisle":"野菜・果物","quantity":0.5,"unit":"パック"},{"id":"kona_dashi","name":"和風だしの素","aisle":"乾物・保存食","quantity":1,"unit":"小さじ"},{"id":"shouyu","name":"しょうゆ","aisle":"調味料","quantity":0.5,"unit":"大さじ"},{"id":"naganegi","name":"長ねぎ","aisle":"野菜・果物","quantity":0.5,"unit":"本"},{"id":"shio","name":"塩","aisle":"調味料","quantity":null,"unit":null}],"steps":["水400mlにだしの素を溶かし、米ときのこを入れて中火で15分煮る。","しょうゆで味を整える。","溶き卵を回し入れ、ふたをして1分蒸らす。","長ねぎを散らす。"],"tips":"前夜に炊いた米が残っていれば、5分で作れる。"},{"id":"pot-mochi-shiruko","name":"くるみといちじくの甘い雑煮","summary":"甘いものが欲しくなる行動後に。乾物だけで作れる。","gear":["バーナー","クッカー"],"cookingMinutes":10,"effort":1,"needsCooler":false,"servings":2,"ingredients":[{"id":"kiri_mochi","name":"切り餅","aisle":"乾物・保存食","quantity":2,"unit":"個"},{"id":"doraifuruutsu","name":"ドライいちじく","aisle":"乾物・保存食","quantity":4,"unit":"個"},{"id":"kurumi","name":"くるみ","aisle":"乾物・保存食","quantity":20,"unit":"g"},{"id":"hachimitsu","name":"はちみつ","aisle":"調味料","quantity":2,"unit":"大さじ"},{"id":"shio","name":"塩","aisle":"調味料","quantity":null,"unit":null}],"steps":["水300mlを沸かし、刻んだいちじくを入れて5分煮る。","切り餅を加え、柔らかくなるまで煮る。","はちみつと塩ひとつまみで味を決める。","砕いたくるみを散らす。"],"tips":"塩をひとつまみ入れると甘さが立つ。"}]